{
  "name": "gangadhara-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000 -H localhost",
    "build": "next build",
    "start": "next start -p 5000 -H localhost",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:depth": "NEXT_PUBLIC_DESIGN=depth next dev -p 5001 -H localhost",
    "build:depth": "NEXT_PUBLIC_DESIGN=depth next build",
    "start:depth": "NEXT_PUBLIC_DESIGN=depth next start -p 5001 -H localhost",
    "globe:map": "node scripts/globe/borders.mjs",
    "globe:lights": "node scripts/globe/lights.mjs",
    "globe:icons": "node scripts/globe/icons.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "all-the-cities": "^3.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "simple-icons": "^16.32.0",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "world-atlas": "^2.0.2"
  }
}
